# Local qualification only. Copy to .env and provide private values there.
TEST_DB_SYNC_OBJECT_STORAGE_ENDPOINT=https://s3.example.invalid
TEST_DB_SYNC_OBJECT_STORAGE_ACCESS_KEY_ID=
TEST_DB_SYNC_OBJECT_STORAGE_SECRET_ACCESS_KEY=
TEST_DB_SYNC_OBJECT_STORAGE_REGION=
TEST_DB_SYNC_OBJECT_STORAGE_BUCKET=

# A dedicated kubeconfig path; keep credential material outside the repository.
NEON_K8S_KUBECONFIG=C:/Users/USERNAME/.kube/klustr-neon-local.yaml
NEON_K8S_CONTEXT=kubernetes-admin@klustr-runtime-local
NEON_K8S_NODE_CONTAINER=klustr-runtime-local-control-plane
NEON_K8S_STORAGE_CLASS=standard
NEON_K8S_NAMESPACE_PREFIX=neon-pg18-qualification

# Optional Windows Docker Desktop benchmark storage on a secondary drive.
# New retained native ext4 VHDs only; no existing Docker data is moved/deleted.
# Requires administrator access and 40 GiB free here. Leave blank for Docker local volumes.
NEON_BENCHMARK_VOLUME_ROOT=
NEON_BENCHMARK_VOLUME_PROVIDER=vhd


# Optional read-only capacity guard for a self-hosted S3 backend. The SSH host
# must resolve to the configured S3 endpoint, with verified known-host keys.
NEON_S3_CAPACITY_SSH_HOST=
NEON_S3_CAPACITY_MOUNT=/data
NEON_S3_CAPACITY_START_GIB=12
NEON_S3_CAPACITY_STOP_GIB=8
