# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0
COPY neon/packaging/docker/shared/debian.sources /etc/apt/sources.list.d/debian.sources
COPY neon/packaging/docker/shared/install-debian-packages.sh /usr/local/libexec/neon/install-debian-packages.sh
RUN sh /usr/local/libexec/neon/install-debian-packages.sh \
    clang libclang-dev cmake pkg-config protobuf-compiler libprotobuf-dev libssl-dev \
    libpq-dev libseccomp-dev liburing-dev liblz4-dev libzstd-dev python3 bison flex \
    libreadline-dev libicu-dev libxml2-dev libxslt1-dev zlib1g-dev libnghttp2-dev \
    libgcrypt20-dev libipc-run-perl libio-pty-perl
ARG BUILD_JOBS=8
COPY --from=native-inputs / /native-archives/
COPY neon/packaging/neon/native-dependencies.lock.json /out/qualification/native-dependencies.lock.json
COPY neon/vendor/pg-ffi/ /opt/postgres/
RUN mkdir -p /native-src /native-build \
    && for archive in /native-archives/*.tar.xz; do tar -xf "$archive" -C /native-src; done \
    && cp /native-archives/run_and_diff.cmake /native-archives/test_xmlcatalog_add_del.cmake /native-src/libxml2-2.15.4/
COPY neon/vendor/native/zlib/gzwrite.c /native-src/zlib-1.3.2/gzwrite.c
ENV PKG_CONFIG_PATH=/opt/neon-native/lib/pkgconfig \
    LD_LIBRARY_PATH=/opt/neon-native/lib \
    CPPFLAGS="-I/opt/neon-native/include" \
    LDFLAGS="-L/opt/neon-native/lib -Wl,-rpath,/opt/neon-native/lib"
RUN cd /native-src/zlib-1.3.2 && ./configure --prefix=/opt/neon-native \
    && make -j${BUILD_JOBS} && make install
RUN cmake -S /native-src/libxml2-2.15.4 -B /native-build/libxml2 \
       -DCMAKE_INSTALL_PREFIX=/opt/neon-native -DCMAKE_INSTALL_LIBDIR=lib \
       -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_RPATH=/opt/neon-native/lib \
       -DBUILD_SHARED_LIBS=ON -DLIBXML2_WITH_PYTHON=OFF -DLIBXML2_WITH_TESTS=ON -DLIBXML2_WITH_LEGACY=ON \
    && cmake --build /native-build/libxml2 -j${BUILD_JOBS} \
    && cmake --install /native-build/libxml2
RUN cd /native-src/libxslt-1.1.45 \
    && ./configure --prefix=/opt/neon-native --without-python --with-libxml-prefix=/opt/neon-native --disable-static \
    && make -j${BUILD_JOBS} && make install
RUN cd /native-src/curl-8.23.0 \
    && ./configure --prefix=/opt/neon-native --with-openssl --with-zlib=/opt/neon-native --with-zstd --with-nghttp2 \
       --without-libssh --without-libssh2 --without-librtmp --without-libpsl --without-libidn2 --without-brotli \
       --without-gssapi --disable-ldap --disable-ldaps --disable-static \
    && make -j${BUILD_JOBS} && make install

RUN groupadd --gid 10002 qualification && useradd --uid 10002 --gid 10002 --no-create-home qualification \
    && mkdir -p /out/licenses/native \
    && cp /native-src/zlib-1.3.2/LICENSE /out/licenses/native/zlib-LICENSE \
    && cp /native-src/libxml2-2.15.4/Copyright /out/licenses/native/libxml2-Copyright \
    && cp /native-src/libxslt-1.1.45/Copyright /out/licenses/native/libxslt-Copyright \
    && cp /native-src/curl-8.23.0/COPYING /out/licenses/native/curl-COPYING
ENV POSTGRES_INSTALL_DIR=/opt/postgres RUSTUP_TOOLCHAIN=1.88.0
LABEL io.klustr.toolchain="pg18-monorepo"
